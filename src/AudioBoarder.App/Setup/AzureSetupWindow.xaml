<ui:FluentWindow x:Class="AudioBoarder.App.Setup.AzureSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Azure services and models"
                 Width="920" Height="760" MinWidth="780" MinHeight="640"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Azure services and models" />
        <StackPanel Grid.Row="1" Margin="24,8,24,16">
            <TextBlock Text="Set up AudioBoarder" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AccountSummary}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.Name="Signed-in Azure account" />
        </StackPanel>
        <TabControl x:Name="Steps" Grid.Row="2" Margin="24,0"
                    SelectionChanged="OnStepChanged" AutomationProperties.Name="Azure setup steps">
            <TabItem Header="1. Services">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Find or set up Azure services" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:Button Content="Sign in / change account" Click="OnSignIn"
                                       IsEnabled="{Binding IsIdle}"
                                       AutomationProperties.Name="Sign in from Azure setup" />
                            <ui:Button Content="Refresh" Margin="10,0,0,0" Click="OnRefresh"
                                       IsEnabled="{Binding IsIdle}"
                                       AutomationProperties.Name="Refresh Azure resources" />
                        </StackPanel>
                        <TextBlock Text="Azure subscription" />
                        <ComboBox MinHeight="34" Margin="0,5,0,14"
                                  ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription}"
                                  DisplayMemberPath="DisplayName" SelectionChanged="OnSubscriptionChanged"
                                  IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="Azure setup subscription" />
                        <TextBlock Text="Azure OpenAI or Microsoft Foundry resource" />
                        <ComboBox MinHeight="34" Margin="0,5,0,14"
                                  ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="Azure setup resource" />
                        <TextBlock Margin="0,8,0,10" TextWrapping="Wrap"
                                   Text="Create an Azure OpenAI or Foundry resource here with your signed-in account, then deploy compatible models from the Models step. Azure will enforce your subscription permissions, policy and quota." />
                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button Content="Create Azure OpenAI..." Click="OnOpenAzureOpenAI" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanProvision}" AutomationProperties.Name="Create Azure OpenAI resource" />
                            <ui:Button Content="Create Foundry resource..." Click="OnOpenFoundry" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanProvision}" AutomationProperties.Name="Create Microsoft Foundry resource" />
                            <ui:Button Content="Deploy chat model..." Click="OnDeployChat" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanDeploy}" AutomationProperties.Name="Deploy initial chat model" />
                            <ui:Button Content="Manage selected resource" Click="OnManageResource" Margin="0,0,8,8" />
                            <ui:Button Content="Subscription access" Click="OnSubscriptionAccess" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="AudioBoarder never provisions billable resources automatically. Creation requires your explicit confirmation of the configuration and charges. Cancelling this setup wizard does not delete resources already created in Azure. Manage selected resource and Subscription access open Microsoft portals; creation and deployment run in this native app." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Choose deployed models" Style="{StaticResource Heading}" />
                        <WrapPanel Margin="0,0,0,14">
                            <ui:Button Content="Deploy chat model..." Click="OnDeployChat" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanDeploy}" AutomationProperties.Name="Deploy a chat model" />
                            <ui:Button Content="Deploy transcription..." Click="OnDeployTranscription" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanDeploy}" AutomationProperties.Name="Deploy a transcription model" />
                            <ui:Button Content="Deploy image model..." Click="OnDeployImage" Margin="0,0,8,8"
                                       IsEnabled="{Binding CanDeploy}" AutomationProperties.Name="Deploy an image model" />
                        </WrapPanel>
                        <TextBlock Text="Primary diagram model (required)" />
                        <ComboBox MinHeight="34" Margin="0,5,0,14"
                                  ItemsSource="{Binding ChatDeployments}" SelectedItem="{Binding SelectedChat}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="Primary diagram model" />
                        <TextBlock Text="Fast / fallback diagram model (same resource; optional)" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Use primary" Click="OnClearFast" Margin="8,5,0,14" />
                            <ComboBox MinHeight="34" Margin="0,5,0,14"
                                      ItemsSource="{Binding ChatDeployments}" SelectedItem="{Binding SelectedFastChat}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Fast diagram model" />
                        </DockPanel>
                        <TextBlock Text="Transcription" />
                        <ComboBox MinHeight="34" Margin="0,5,0,14"
                                  SelectedValue="{Binding TranscriptionBackend}" SelectedValuePath="Tag"
                                  AutomationProperties.Name="Setup transcription backend">
                            <ComboBoxItem Tag="auto" Content="Auto - cloud if selected, otherwise local Whisper" />
                            <ComboBoxItem Tag="cloud" Content="Cloud - requires a transcription deployment" />
                            <ComboBoxItem Tag="local" Content="Local Whisper - no Azure transcription resource needed" />
                            <ComboBoxItem Tag="speech" Content="Azure Speech - use the resource configured in Settings" />
                        </ComboBox>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="None" Click="OnClearTranscription" Margin="8,5,0,14" />
                            <ComboBox MinHeight="34" Margin="0,5,0,14"
                                      ItemsSource="{Binding TranscriptionDeployments}"
                                      SelectedItem="{Binding SelectedTranscription}" DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Cloud transcription model" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding EnableImages}" Content="Enable optional image generation" Margin="0,0,0,4" />
                        <ComboBox MinHeight="34" Margin="0,5,0,14"
                                  ItemsSource="{Binding ImageDeployments}" SelectedItem="{Binding SelectedImage}"
                                  DisplayMemberPath="DisplayName" IsEnabled="{Binding EnableImages}"
                                  AutomationProperties.Name="Image generation model" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Only ready, compatible deployments appear. Cloud transcription and image models can be hosted in another resource in this subscription; their endpoints are saved separately. Local Whisper may download its model on first use. Leave image generation off if you do not need it." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="3. Review">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Review your model configuration" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" LineHeight="26"
                                   AutomationProperties.Name="Azure setup review" />
                        <TextBlock Margin="0,24,0,0" TextWrapping="Wrap"
                                   Text="Your choices are stored locally under this account profile. Automatic model ranking will not replace an explicit choice. You can change the resource and models later in Settings > Azure > Choose resources and models." />
                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Sign-in and resource visibility do not grant inference access or quota. An administrator may need to assign Cognitive Services OpenAI User or the appropriate Foundry role, and allow your network to reach the endpoint. Model access is enforced by Azure on each request." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Padding="14" Margin="24,12,24,8" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="90"
                       AutomationProperties.Name="Azure setup status"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Grid Grid.Row="4" Margin="24,8,24,20">
            <ui:Button Content="Not now" HorizontalAlignment="Left" Click="OnCancel"
                       AutomationProperties.Name="Cancel Azure setup" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="BackButton" Content="Back" MinWidth="90" Click="OnBack" IsEnabled="False" />
                <ui:Button x:Name="NextButton" Content="Next" MinWidth="90" Margin="8,0,0,0" Click="OnNext" />
                <ui:Button x:Name="FinishButton" Content="Use selected models" Appearance="Primary"
                           Margin="8,0,0,0" Visibility="Collapsed" Click="OnFinish"
                           IsEnabled="{Binding CanSave}"
                           AutomationProperties.Name="Use selected Azure models" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
