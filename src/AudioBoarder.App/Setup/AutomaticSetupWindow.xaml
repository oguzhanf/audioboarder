<ui:FluentWindow x:Class="AudioBoarder.App.Setup.AutomaticSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Prepare your workspace" Width="680" Height="590" MinWidth="620" MinHeight="560"
 WindowStartupLocation="CenterOwner" WindowBackdropType="Mica"
 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="AudioBoarder workspace"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32,18,32,12">
   <TextBlock Text="Ready for your next conversation" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Account}" Margin="0,10,0,22" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   <TextBlock Text="No deployment names. No model shopping." FontWeight="SemiBold" FontSize="16"/>
   <TextBlock Text="AudioBoarder connects continuous live speech, chooses a fast diagram model, and saves a working configuration for your Azure account." TextWrapping="Wrap" Margin="0,8,0,20" LineHeight="22"/>
   <Border Padding="16" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="10">
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </Border>
   <CheckBox x:Name="Approval" IsChecked="{Binding Approved}" Margin="0,20,0,10" AutomationProperties.Name="Approve automatic workspace setup">
    <TextBlock Text="I approve creating or reusing Azure resources and granting my account speech/model usage access. Azure usage charges and organizational policies apply." TextWrapping="Wrap"/>
   </CheckBox>
   <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="5" Margin="0,8,0,12"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Automatic setup status"/>
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="32,12,32,24">
   <ui:Button x:Name="Later" Content="{Binding CancelLabel}" Click="OnLater" Margin="0,0,10,0"/>
   <ui:Button x:Name="Start" Content="Set up for me" Appearance="Primary" IsEnabled="{Binding CanStart}" Click="OnStart" MinWidth="140" AutomationProperties.Name="Set up my workspace automatically"/>
   <ui:Button x:Name="Done" Content="Done" Appearance="Primary" IsEnabled="{Binding Completed}" Visibility="Collapsed" Click="OnDone" Margin="10,0,0,0" AutomationProperties.Name="Finish automatic workspace setup"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
