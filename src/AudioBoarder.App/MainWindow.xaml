<ui:FluentWindow x:Class="AudioBoarder.App.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AudioBoarder.App.ViewModels"
                 xmlns:ctrl="clr-namespace:AudioBoarder.App.Controls"
                 mc:Ignorable="d"
                 Title="AudioBoarder"
                 Icon="Assets/AudioBoarder.ico"
                 Height="760"
                 Width="1240"
                 MinHeight="640"
                 MinWidth="1180"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <ui:FluentWindow.Resources>
        <ctrl:HealthStatusBrushConverter x:Key="HealthBrush" />
        <ctrl:BoolVisibilityConverter x:Key="BoolVis" />
        <ctrl:InverseBoolVisibilityConverter x:Key="InverseBoolVis" />
        <ctrl:BoolToStringConverter x:Key="BoolToString" />
        <ctrl:NoteKindBrushConverter x:Key="NoteKindBrush" />

        <!-- Grouped so a long meeting reads as "Action items / Decisions / Risks"
             instead of one undifferentiated column of tiny coloured rows. -->
        <CollectionViewSource x:Key="GroupedNotes" Source="{Binding Notes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="KindDisplay" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding ToggleListenCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RefineDiagramCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ExportExcalidrawCommand}" />
        <KeyBinding Key="Delete" Modifiers="Ctrl+Shift" Command="{Binding ClearSceneCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AudioBoarder" />

        <Border Grid.Row="1"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Both groups shrink. Auto on the left let the action group
                         claim whatever it wanted and push the mic/device group off
                         the right edge; star lets each give ground under pressure. -->
                    <ColumnDefinition Width="Auto" MinWidth="0" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button Command="{Binding ToggleListenCommand}"
                               Content="{Binding IsListening, Converter={StaticResource BoolToString}, ConverterParameter='Listen|Stop'}"
                               Appearance="Primary"
                               MinWidth="104"
                               Height="34"
                               Padding="12,0"
                               ToolTip="Start or stop live capture. Shortcut: Ctrl+Shift+L."
                               AutomationProperties.Name="Start or stop listening">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Mic24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding ImportTranscriptCommand}"
                               Content="Import"
                               Height="34"
                               Padding="12,0"
                               Margin="6,0,0,0"
                               ToolTip="Build a diagram from an exported meeting transcript (Teams .vtt, .srt or plain text) — no audio needed."
                               AutomationProperties.Name="Import a meeting transcript">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentArrowUp20" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <Rectangle Width="1"
                               Height="20"
                               Margin="10,0"
                               Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <ui:Button Command="{Binding RefineDiagramCommand}"
                               Content="Refine"
                               Height="34"
                               Padding="12,0"
                               ToolTip="Run a thorough pass with the deep model. Shortcut: Ctrl+Shift+R."
                               AutomationProperties.Name="Run deep refine">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Sparkle24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:TextBox Width="150"
                                MinWidth="90"
                                Height="34"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center"
                                Text="{Binding RefinementInstruction, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Refine instruction…"
                                ToolTip="Optional instruction for refine, for example 'group the database operations'."
                                AutomationProperties.Name="Deep refine instruction" />

                    <Rectangle Width="1"
                               Height="20"
                               Margin="10,0"
                               Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <!-- Export and destructive actions are icon-only: the tooltip
                         carries the meaning and the labels were crowding out the
                         primary action. -->
                    <ui:Button Command="{Binding ExportPngCommand}"
                               Height="34"
                               Width="38"
                               Padding="0"
                               ToolTip="Export the diagram as a PNG image."
                               AutomationProperties.Name="Export PNG">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Image24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding ExportExcalidrawCommand}"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="Save an editable .excalidraw file. Shortcut: Ctrl+Shift+E."
                               AutomationProperties.Name="Export Excalidraw">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DrawShape24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding ClearSceneCommand}"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="Clear the board. Shortcut: Ctrl+Shift+Delete."
                               AutomationProperties.Name="Clear scene">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <Rectangle Width="1"
                               Height="20"
                               Margin="10,0"
                               Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <ui:Button x:Name="TranscriptPaneButton"
                               Click="OnToggleTranscriptPane"
                               Height="34"
                               Width="38"
                               Padding="0"
                               ToolTip="Hide or show the transcript panel."
                               AutomationProperties.Name="Toggle transcript panel">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="NotesPaneButton"
                               Click="OnToggleNotesPane"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="Hide or show the notes panel."
                               AutomationProperties.Name="Toggle notes panel">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Note24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Click="OnShowWelcome"
                               Appearance="Transparent"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="Open the getting-started guide."
                               AutomationProperties.Name="Open help and getting started">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="QuestionCircle24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Star so the device list absorbs slack and elides its own
                             text rather than pushing the refresh button off-screen. -->
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sign in surfaces only while Azure is unavailable; the health
                         panel that used to host it is gone, so this is now the only
                         way in. -->
                    <ui:Button Grid.Column="0"
                               Command="{Binding SignInToAzureCommand}"
                               Content="Sign in"
                               Appearance="Primary"
                               Height="34"
                               Padding="12,0"
                               Margin="0,0,6,0"
                               Visibility="{Binding IsAzureReady, Converter={StaticResource InverseBoolVis}}"
                               ToolTip="Sign in to your Azure tenant (opens a browser)."
                               AutomationProperties.Name="Sign in to Azure">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonKey24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="1"
                               Command="{Binding RetryHealthCommand}"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="0,0,10,0"
                               ToolTip="Re-run the component health checks."
                               AutomationProperties.Name="Retry health checks">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ProgressBar Grid.Column="2"
                                 Width="72"
                                 Height="4"
                                 Margin="0,0,8,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding MicLevel, Mode=OneWay}"
                                 Foreground="{DynamicResource SystemAccentBrush}"
                                 VerticalAlignment="Center"
                                 ToolTip="Live microphone level. If this stays flat while you talk, pick another device."
                                 AutomationProperties.Name="Microphone input level" />

                    <ComboBox Grid.Column="3"
                              Height="34"
                              MaxWidth="200"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              ToolTip="Choose which microphone to capture. Shared mode — Teams keeps using it too."
                              AutomationProperties.Name="Input device">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:Button Grid.Column="4"
                               Command="{Binding RefreshInputDevicesCommand}"
                               Appearance="Transparent"
                               Height="34"
                               Width="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="Rescan microphones."
                               AutomationProperties.Name="Refresh input devices">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Grid>
        </Border>



        <Grid Grid.Row="2" Margin="8,8,8,10">
            <Grid.ColumnDefinitions>
                <!-- Proportional with a floor so the side rails give ground to the
                     canvas as the window narrows, instead of holding a fixed width
                     and squeezing the whiteboard to nothing. -->
                <ColumnDefinition x:Name="TranscriptColumn" Width="0.22*" MinWidth="220" MaxWidth="360" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="NotesColumn" Width="0.24*" MinWidth="240" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TranscriptPane"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Transcript panel">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live transcript"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Rolling captions from the active microphone."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Click="OnToggleTranscriptPane"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       ToolTip="Hide the transcript panel"
                                       AutomationProperties.Name="Hide transcript panel">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TranscriptBox"
                             Text="{Binding TranscriptDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             Padding="12,10"
                             AutomationProperties.Name="Live transcript"
                             ToolTip="Read-only live transcript." />
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    AutomationProperties.Name="Diagram canvas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ShowWhiteboard, Converter={StaticResource BoolToString}, ConverterParameter='Classic canvas|Live whiteboard'}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Scroll to zoom. Drag any node to pin it where you want."
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,8,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Margin="0,4,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsListening, Converter={StaticResource BoolToString}, ConverterParameter='Standby|Listening'}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,8,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing Width="14"
                                                         Height="14"
                                                         Margin="0,0,6,0"
                                                         IsIndeterminate="True"
                                                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="{Binding IsGenerating, Converter={StaticResource BoolToString}, ConverterParameter='Ready|Updating'}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource SystemAccentBrush}">
                                    <TextBlock Text="{Binding SceneRevision, StringFormat='rev {0}'}"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               AutomationProperties.Name="Scene revision" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ctrl:ExcalidrawCanvas x:Name="Whiteboard"
                                               Visibility="{Binding ShowWhiteboard, Converter={StaticResource BoolVis}}" />
                        <ctrl:SceneCanvas x:Name="Canvas"
                                          Visibility="{Binding ShowClassicView, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="NotesPane"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Notes panel">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Notes"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Decisions, action items, and risks from the session."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Click="OnToggleNotesPane"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       ToolTip="Hide the notes panel"
                                       AutomationProperties.Name="Hide notes panel">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="NotesList"
                             ItemsSource="{Binding Source={StaticResource GroupedNotes}}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Session notes">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,4" Padding="2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                CornerRadius="2"
                                                Margin="0,1,10,1"
                                                Background="{Binding Kind, Converter={StaticResource NoteKindBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Owner}"
                                                           Visibility="{Binding HasOwner, Converter={StaticResource BoolVis}}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Time}"
                                                           Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Component health lives here rather than in a panel that pushed the
                     canvas down: a traffic-light per check is all the signal needed,
                     and the detail is available on hover. -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding HealthStates}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              AutomationProperties.Name="Component health">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding Detail}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="{Binding Detail}">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Ctrl+Shift+L listen  •  Ctrl+Shift+R refine  •  Ctrl+Shift+E export" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
