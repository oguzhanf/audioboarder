<ui:FluentWindow x:Class="AudioBoarder.App.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:AudioBoarder.App"
                 xmlns:vm="clr-namespace:AudioBoarder.App.ViewModels"
                 xmlns:ctrl="clr-namespace:AudioBoarder.App.Controls"
                 mc:Ignorable="d"
                 Title="AudioBoarder"
                 Icon="Assets/AudioBoarder.ico"
                 Height="760"
                 Width="1240"
                 MinHeight="620"
                 MinWidth="940"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <ui:FluentWindow.Resources>
        <ctrl:HealthStatusBrushConverter x:Key="HealthBrush" />
        <ctrl:BoolVisibilityConverter x:Key="BoolVis" />
        <ctrl:BoolToStringConverter x:Key="BoolToString" />
        <ctrl:NoteKindBrushConverter x:Key="NoteKindBrush" />
        <CollectionViewSource x:Key="GroupedNotes" Source="{Binding Notes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="KindDisplay" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="OemComma"
                    Modifiers="Ctrl"
                    Command="{x:Static local:MainWindow.OpenSettingsCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding ToggleListenCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl+Shift" Command="{Binding ToggleTranscriptPaneCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding ToggleNotesPaneCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RefineDiagramCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Alt" Command="{Binding ReflowUnpinnedCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ExportExcalidrawCommand}" />
        <KeyBinding Key="Delete" Modifiers="Ctrl+Shift" Command="{Binding ClearSceneCommand}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.OpenSettingsCommand}"
                        Executed="OnOpenSettings" />
    </ui:FluentWindow.CommandBindings>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AudioBoarder" />

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="CommandBar" Height="40" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Command="{Binding ToggleListenCommand}"
                           Content="{Binding IsListening, Converter={StaticResource BoolToString}, ConverterParameter='Listen|Stop'}"
                           Appearance="Primary"
                           MinWidth="84"
                           Height="40"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           ToolTip="Start or stop listening. Ctrl+Shift+L."
                           AutomationProperties.Name="Start or stop listening">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Mic24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ComboBox Grid.Column="1"
                          Width="120"
                          Height="36"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding IntentOptions}"
                          SelectedItem="{Binding SelectedIntentOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTip="{Binding IntentModeDisplay, StringFormat='Diagram intent: {0}'}"
                          AutomationProperties.Name="Diagram intent selector" />

                <ui:Button Grid.Column="2"
                           Command="{Binding RefineDiagramCommand}"
                           Content="Refine"
                           Height="40"
                           Padding="12,0"
                           Margin="0,0,6,0"
                           ToolTip="Run a deep refinement pass. Ctrl+Shift+R."
                           AutomationProperties.Name="Deep refine diagram">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:TextBox Grid.Column="3"
                            Height="40"
                            MinWidth="60"
                            Margin="0,0,8,0"
                            Text="{Binding RefinementInstruction, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Optional refine instruction…"
                            ToolTip="Optional instruction for the deep refinement pass."
                            AutomationProperties.Name="Deep refine instruction" />

                <ProgressBar Grid.Column="4"
                             Width="28"
                             Height="4"
                             Margin="0,0,8,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding MicLevel}"
                             Foreground="{DynamicResource SystemAccentBrush}"
                             VerticalAlignment="Center"
                             ToolTip="Microphone input level."
                             AutomationProperties.Name="Microphone input level" />

                <ui:Button Grid.Column="5"
                           x:Name="AudioInputButton"
                           Appearance="Transparent"
                           Height="40"
                           Width="40"
                           Padding="0"
                           Margin="0,0,4,0"
                           Click="OnOpenAudioMenu"
                           ToolTip="{Binding SelectedInputDevice.Name, StringFormat='Audio input: {0}'}"
                           AutomationProperties.Name="Choose audio input">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="MicSettings24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Grid.Column="6"
                           Command="{x:Static local:MainWindow.OpenSettingsCommand}"
                           Appearance="Transparent"
                           Height="40"
                           Width="40"
                           Padding="0"
                           Margin="0,0,4,0"
                           ToolTip="Open Settings. Ctrl+,"
                           AutomationProperties.Name="Open Settings">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Grid.Column="7"
                           x:Name="MoreButton"
                           Appearance="Transparent"
                           Height="40"
                           Width="40"
                           Padding="0"
                           Click="OnOpenMoreMenu"
                           ToolTip="More commands"
                           AutomationProperties.Name="More commands">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:Button.Icon>
                    <ui:Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Import transcript…"
                                      Command="{Binding ImportTranscriptCommand}"
                                      AutomationProperties.Name="Import a meeting transcript" />
                            <MenuItem Header="Export PNG…"
                                      Command="{Binding ExportPngCommand}"
                                      AutomationProperties.Name="Export PNG" />
                            <MenuItem Header="Export to Excalidraw…"
                                      InputGestureText="Ctrl+Shift+E"
                                      Command="{Binding ExportExcalidrawCommand}"
                                      AutomationProperties.Name="Export to Excalidraw" />
                            <Separator />
                            <MenuItem Header="Reflow unpinned nodes"
                                      InputGestureText="Ctrl+Alt+R"
                                      Command="{Binding ReflowUnpinnedCommand}"
                                      AutomationProperties.Name="Reflow unpinned nodes" />
                            <MenuItem Header="Reflow all nodes…"
                                      Command="{Binding RequestReflowAllCommand}"
                                      AutomationProperties.Name="Reflow all nodes" />
                            <MenuItem Header="Clear canvas"
                                      InputGestureText="Ctrl+Shift+Delete"
                                      Command="{Binding ClearSceneCommand}"
                                      AutomationProperties.Name="Clear live architecture canvas" />
                            <Separator />
                            <MenuItem Command="{Binding ToggleTranscriptPaneCommand}"
                                      InputGestureText="Ctrl+Shift+I"
                                      AutomationProperties.Name="Toggle full transcript drawer">
                                <MenuItem.Header>
                                    <TextBlock Text="{Binding CaptionCount, StringFormat='Transcript drawer ({0})'}" />
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding ToggleNotesPaneCommand}"
                                      InputGestureText="Ctrl+Shift+N"
                                      AutomationProperties.Name="Toggle notes drawer">
                                <MenuItem.Header>
                                    <TextBlock Text="{Binding NoteCount, StringFormat='Notes drawer ({0})'}" />
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Sign in to Azure"
                                      Command="{Binding SignInToAzureCommand}"
                                      Visibility="{Binding IsAzureSignInRequired, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="Sign in to Azure" />
                            <MenuItem Header="Retry health checks"
                                      Command="{Binding RetryHealthCommand}"
                                      Visibility="{Binding IsAzureRetryAvailable, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="Retry health checks" />
                            <MenuItem Header="Configure Azure…"
                                      Click="OnConfigureAzure"
                                      Visibility="{Binding IsAzureConfigurationRequired, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="Open Azure configuration" />
                            <MenuItem Header="Settings…"
                                      InputGestureText="Ctrl+,"
                                      Click="OnOpenSettingsMenuItem"
                                      AutomationProperties.Name="Open Settings" />
                            <MenuItem Header="Check for updates…"
                                      Click="OnCheckForUpdates"
                                      AutomationProperties.Name="Check for AudioBoarder updates" />
                            <Separator />
                            <MenuItem Header="Help"
                                      Click="OnShowWelcome"
                                      AutomationProperties.Name="Open canvas keyboard and pinning help" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="8">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Live architecture canvas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="12,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live architecture canvas"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Drag to pin · double-click to pin or unpin · scroll to zoom"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.Name="Canvas interaction help" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="8,4"
                                        Margin="0,0,8,0"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding AppliedIntentDisplay}"
                                               FontSize="11"
                                               AutomationProperties.Name="Current diagram intent" />
                                </Border>
                                <Border Padding="8,4"
                                        CornerRadius="8"
                                        Background="{DynamicResource SystemAccentBrush}">
                                    <TextBlock Text="{Binding SceneRevision, StringFormat='rev {0}'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               AutomationProperties.Name="Scene revision" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ctrl:ExcalidrawCanvas x:Name="Whiteboard"
                                           Grid.Row="1"
                                           AutomationProperties.Name="Interactive live architecture canvas"
                                           AutomationProperties.HelpText="Drag nodes to pin them. Double-click a node to toggle its pinned state." />
                </Grid>
            </Border>

            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="16,64,16,0"
                    Padding="12,8"
                    MaxWidth="720"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemAccentBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasIntentSuggestion, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="Suggested diagram intent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SuggestedIntentDisplay, StringFormat='Looks like {0} — switch?'}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ui:Button Command="{Binding AcceptIntentSuggestionCommand}"
                               Content="Switch"
                               Height="32"
                               Padding="12,0"
                               Appearance="Primary"
                               Margin="0,0,4,0"
                               AutomationProperties.Name="Accept suggested diagram intent" />
                    <ui:Button Command="{Binding DismissIntentSuggestionCommand}"
                               Content="Dismiss"
                               Height="32"
                               Padding="12,0"
                               AutomationProperties.Name="Dismiss suggested diagram intent" />
                </StackPanel>
            </Border>

            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="16,112,16,0"
                    Padding="12,8"
                    MaxWidth="760"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsReflowAllConfirmationVisible, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="Confirm reflow all">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Reflow all will move pinned nodes. Continue?"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ui:Button Command="{Binding ConfirmReflowAllCommand}"
                               Content="Reflow all"
                               Height="32"
                               Padding="12,0"
                               Appearance="Primary"
                               Margin="0,0,4,0"
                               AutomationProperties.Name="Confirm reflow all nodes" />
                    <ui:Button Command="{Binding CancelReflowAllCommand}"
                               Content="Cancel"
                               Height="32"
                               Padding="12,0"
                               AutomationProperties.Name="Cancel reflow all nodes" />
                </StackPanel>
            </Border>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Width="720"
                    MaxWidth="720"
                    Margin="16"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsListening, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="Live caption strip">
                <TextBlock Text="{Binding LiveCaptionDisplay}"
                           TextWrapping="Wrap"
                           MaxHeight="58"
                           FontSize="14"
                           LineHeight="19"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>

            <Border x:Name="TranscriptPane"
                    Width="380"
                    HorizontalAlignment="Left"
                    Margin="8"
                    Padding="0"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsTranscriptPaneOpen, Converter={StaticResource BoolVis}}"
                    Panel.ZIndex="10"
                    AutomationProperties.Name="Full transcript drawer">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Full transcript" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CaptionCount, StringFormat='Captions: {0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Command="{Binding ToggleTranscriptPaneCommand}"
                                       Height="32"
                                       Width="32"
                                       Padding="0"
                                       ToolTip="Close full transcript."
                                       AutomationProperties.Name="Close full transcript drawer">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TranscriptBox"
                             Text="{Binding TranscriptDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             AutomationProperties.Name="Full live transcript" />
                </DockPanel>
            </Border>

            <Border x:Name="NotesPane"
                    Width="380"
                    HorizontalAlignment="Right"
                    Margin="8"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsNotesPaneOpen, Converter={StaticResource BoolVis}}"
                    Panel.ZIndex="10"
                    AutomationProperties.Name="Notes drawer">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Notes" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NoteCount, StringFormat='Notes: {0} · decisions, actions, risks, and questions'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Command="{Binding ToggleNotesPaneCommand}"
                                       Height="32"
                                       Width="32"
                                       Padding="0"
                                       ToolTip="Close notes."
                                       AutomationProperties.Name="Close notes drawer">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedNotes}}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Session notes">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="2,8,2,4"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Kind, Converter={StaticResource NoteKindBrush}}"
                                                CornerRadius="2"
                                                Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding Time}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="12,6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RuntimeStatus.Label}"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"
                               AutomationProperties.Name="Runtime state" />
                    <TextBlock Text="{Binding RuntimeStatus.Details}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620"
                               AutomationProperties.Name="Runtime state details" />
                    <ui:Button Command="{Binding DismissRuntimeFaultCommand}"
                               Content="Dismiss"
                               Height="32"
                               Padding="10,0"
                               Margin="8,0,0,0"
                               Visibility="{Binding IsRuntimeFaultVisible, Converter={StaticResource BoolVis}}"
                               AutomationProperties.Name="Dismiss runtime fault" />
                </StackPanel>
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding HealthStates}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Component health">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        ToolTip="{Binding Detail}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="{Binding Detail}">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         Fill="{Binding Status, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusLabel, StringFormat=' · {0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="8,0">
                    <ui:Button Command="{Binding SignInToAzureCommand}"
                               Content="Sign in to Azure"
                               Appearance="Primary"
                               Height="32"
                               Padding="10,0"
                               Margin="0,0,6,0"
                               Visibility="{Binding IsAzureSignInRequired, Converter={StaticResource BoolVis}}"
                               AutomationProperties.Name="Sign in to Azure" />
                    <ui:Button Command="{Binding RetryHealthCommand}"
                               Content="Retry"
                               Height="32"
                               Padding="10,0"
                               Margin="0,0,6,0"
                               Visibility="{Binding IsAzureRetryAvailable, Converter={StaticResource BoolVis}}"
                               AutomationProperties.Name="Retry Azure health checks" />
                    <ui:Button Click="OnConfigureAzure"
                               Content="Configure"
                               Height="32"
                               Padding="10,0"
                               Visibility="{Binding IsAzureConfigurationRequired, Converter={StaticResource BoolVis}}"
                               AutomationProperties.Name="Open Azure configuration" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
