<ui:FluentWindow x:Class="AudioBoarder.App.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AudioBoarder.App.ViewModels"
                 xmlns:ctrl="clr-namespace:AudioBoarder.App.Controls"
                 mc:Ignorable="d"
                 Title="AudioBoarder"
                 Icon="Assets/AudioBoarder.ico"
                 Height="760"
                 Width="1240"
                 MinHeight="640"
                 MinWidth="980"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <ui:FluentWindow.Resources>
        <ctrl:HealthStatusBrushConverter x:Key="HealthBrush" />
        <ctrl:BoolVisibilityConverter x:Key="BoolVis" />
        <ctrl:BoolToStringConverter x:Key="BoolToString" />
        <ctrl:NoteKindBrushConverter x:Key="NoteKindBrush" />

        <!-- Grouped so a long meeting reads as "Action items / Decisions / Risks"
             instead of one undifferentiated column of tiny coloured rows. -->
        <CollectionViewSource x:Key="GroupedNotes" Source="{Binding Notes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="KindDisplay" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding ToggleListenCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RefineDiagramCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ExportExcalidrawCommand}" />
        <KeyBinding Key="Delete" Modifiers="Ctrl+Shift" Command="{Binding ClearSceneCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AudioBoarder" />

        <Border Grid.Row="1"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           VerticalAlignment="Center"
                           ItemHeight="36">
                    <ui:Button Command="{Binding ToggleListenCommand}"
                               Content="{Binding IsListening, Converter={StaticResource BoolToString}, ConverterParameter='Listen|Stop'}"
                               Appearance="Primary"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Start or stop live capture. Shortcut: Ctrl+Shift+L."
                               AutomationProperties.Name="Start or stop listening">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Mic24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding RefineDiagramCommand}"
                               Content="Deep Refine"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Run a thorough pass with the active deep model. Shortcut: Ctrl+Shift+R."
                               AutomationProperties.Name="Run deep refine">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Sparkle24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:TextBox Width="230"
                                MinHeight="36"
                                Margin="0,0,6,6"
                                VerticalAlignment="Center"
                                Text="{Binding RefinementInstruction, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Refinement instruction"
                                ToolTip="Optional instruction for deep refine, for example 'group the database operations'."
                                AutomationProperties.Name="Deep refine instruction" />

                    <ui:Button Command="{Binding ExportPngCommand}"
                               Content="PNG"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Export the current diagram as a PNG image."
                               AutomationProperties.Name="Export PNG">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding ExportExcalidrawCommand}"
                               Content="Excalidraw"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Save a hand-drawn .excalidraw file. Shortcut: Ctrl+Shift+E."
                               AutomationProperties.Name="Export Excalidraw">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DrawShape24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding ClearSceneCommand}"
                               Content="Clear"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,10,6"
                               ToolTip="Clear the current scene. Shortcut: Ctrl+Shift+Delete."
                               AutomationProperties.Name="Clear scene">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:ToggleSwitch Content="Whiteboard"
                                     IsChecked="{Binding ShowWhiteboard, Mode=TwoWay}"
                                     MinHeight="36"
                                     Margin="0,0,10,6"
                                     VerticalAlignment="Center"
                                     ToolTip="Toggle between the hand-drawn Excalidraw whiteboard and the classic renderer."
                                     AutomationProperties.Name="Toggle whiteboard mode" />

                    <ui:Button x:Name="TranscriptPaneButton"
                               Click="OnToggleTranscriptPane"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Hide or show the transcript panel."
                               AutomationProperties.Name="Toggle transcript panel" />

                    <ui:Button x:Name="NotesPaneButton"
                               Click="OnToggleNotesPane"
                               MinHeight="36"
                               Padding="12,6"
                               Margin="0,0,6,6"
                               ToolTip="Hide or show the notes panel."
                               AutomationProperties.Name="Toggle notes panel" />

                    <ui:Button Click="OnShowWelcome"
                               Appearance="Transparent"
                               MinHeight="36"
                               Padding="10,6"
                               Margin="0,0,6,6"
                               ToolTip="Open the getting-started guide."
                               AutomationProperties.Name="Open help and getting started">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="QuestionCircle24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           ItemHeight="36">
                    <TextBlock Margin="0,0,8,6"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Mic" />
                    <ProgressBar Width="82"
                                 Height="6"
                                 Margin="0,0,8,6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding MicLevel, Mode=OneWay}"
                                 Foreground="{DynamicResource SystemAccentBrush}"
                                 VerticalAlignment="Center"
                                 ToolTip="Live microphone input level. If this stays flat while you talk, pick another device."
                                 AutomationProperties.Name="Microphone input level" />
                    <ComboBox Width="210"
                              MinHeight="36"
                              Margin="0,0,6,6"
                              ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center"
                              ToolTip="Choose which microphone to capture. Shared mode — Teams keeps using it too."
                              AutomationProperties.Name="Input device" />
                    <ui:Button Command="{Binding RefreshInputDevicesCommand}"
                               Appearance="Transparent"
                               MinHeight="36"
                               Padding="10,6"
                               Margin="0,0,0,6"
                               ToolTip="Rescan microphones"
                               AutomationProperties.Name="Refresh input devices">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Visibility="{Binding IsHealthPanelVisible, Converter={StaticResource BoolVis}}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Command="{Binding SignInToAzureCommand}"
                               Content="Sign In"
                               MinHeight="34"
                               Padding="12,5"
                               ToolTip="Sign in to your Azure tenant (opens a browser)."
                               Margin="6,0,0,0"
                               AutomationProperties.Name="Sign in to Azure">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonKey24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding RetryHealthCommand}"
                               Content="Retry"
                               MinHeight="34"
                               Padding="12,5"
                               Margin="6,0,0,0"
                               AutomationProperties.Name="Retry health checks">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding DismissHealthPanelCommand}"
                               Appearance="Transparent"
                               MinHeight="34"
                               Padding="8,5"
                               Margin="6,0,0,0"
                               ToolTip="Dismiss the health panel"
                               AutomationProperties.Name="Dismiss health panel">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss20" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding HealthStates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Margin="0,1,8,0"
                                             VerticalAlignment="Top"
                                             Fill="{Binding Status, Converter={StaticResource HealthBrush}}"
                                             AutomationProperties.HelpText="{Binding Status}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="340" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="8,8,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TranscriptColumn" Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="NotesColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TranscriptPane"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Transcript panel">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live transcript"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Rolling captions from the active microphone."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Click="OnToggleTranscriptPane"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       ToolTip="Hide the transcript panel"
                                       AutomationProperties.Name="Hide transcript panel">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TranscriptBox"
                             Text="{Binding TranscriptDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             Padding="12,10"
                             AutomationProperties.Name="Live transcript"
                             ToolTip="Read-only live transcript." />
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    AutomationProperties.Name="Diagram canvas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ShowWhiteboard, Converter={StaticResource BoolToString}, ConverterParameter='Classic canvas|Live whiteboard'}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Wheel zoom is enabled on the whiteboard. Drag shapes to lock layout."
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,8,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Margin="0,4,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsListening, Converter={StaticResource BoolToString}, ConverterParameter='Standby|Listening'}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,8,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing Width="14"
                                                         Height="14"
                                                         Margin="0,0,6,0"
                                                         IsIndeterminate="True"
                                                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="{Binding IsGenerating, Converter={StaticResource BoolToString}, ConverterParameter='Ready|Updating'}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="10,4"
                                        CornerRadius="999"
                                        Background="{DynamicResource SystemAccentBrush}">
                                    <TextBlock Text="{Binding SceneRevision, StringFormat='rev {0}'}"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               AutomationProperties.Name="Scene revision" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ctrl:ExcalidrawCanvas x:Name="Whiteboard"
                                               Visibility="{Binding ShowWhiteboard, Converter={StaticResource BoolVis}}" />
                        <ctrl:SceneCanvas x:Name="Canvas"
                                          Visibility="{Binding ShowClassicView, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="NotesPane"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Notes panel">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Notes"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Decisions, action items, and risks from the session."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Click="OnToggleNotesPane"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       ToolTip="Hide the notes panel"
                                       AutomationProperties.Name="Hide notes panel">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="NotesList"
                             ItemsSource="{Binding Source={StaticResource GroupedNotes}}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Session notes">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,4" Padding="2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                CornerRadius="2"
                                                Margin="0,1,10,1"
                                                Background="{Binding Kind, Converter={StaticResource NoteKindBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Owner}"
                                                           Visibility="{Binding HasOwner, Converter={StaticResource BoolVis}}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Time}"
                                                           Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Ctrl+Shift+L listen  •  Ctrl+Shift+R refine  •  Ctrl+Shift+E export  •  Ctrl+Shift+Delete clear" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
