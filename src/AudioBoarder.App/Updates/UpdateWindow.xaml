<ui:FluentWindow x:Class="AudioBoarder.App.Updates.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AudioBoarder update"
                 Icon="../Assets/AudioBoarder.ico"
                 Width="680"
                 Height="560"
                 MinWidth="600"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,22,28,16">
            <TextBlock x:Name="TitleText"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="A new AudioBoarder update is available" />
            <TextBlock x:Name="VersionText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="28,0"
                Padding="18"
                CornerRadius="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="What's new"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <TextBox x:Name="ReleaseNotesBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         AutomationProperties.Name="Release notes" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28,18,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="DownloadProgress"
                         Height="7"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Preparing update…" />
            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button x:Name="LaterButton"
                           MinWidth="112"
                           MinHeight="36"
                           Margin="0,0,8,0"
                           Content="Remind me later"
                           Click="OnRemindLater" />
                <ui:Button x:Name="UpdateNowButton"
                           MinWidth="132"
                           MinHeight="36"
                           Appearance="Primary"
                           Content="Update and restart"
                           IsEnabled="False"
                           Click="OnUpdateNow" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
