<ui:FluentWindow x:Class="AudioBoarder.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AudioBoarder Settings"
                 Icon="Assets/AudioBoarder.ico"
                 Width="900"
                 Height="720"
                 MinWidth="760"
                 MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False">
    <ui:FluentWindow.BindingGroup>
        <BindingGroup />
    </ui:FluentWindow.BindingGroup>
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,16,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <TabControl Grid.Row="1" Margin="20,10,20,0" AutomationProperties.Name="Settings sections">
            <TabItem Header="General / Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="General / Appearance" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ThemeCombo"
                                      MinHeight="32" Margin="0,4"
                                      Grid.Column="1"
                                      SelectedItem="{Binding Theme}"
                                      AutomationProperties.Name="Application theme" />
                            <TextBlock Grid.Row="1" Text="Save boards automatically" Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding Sessions.AutoSave}"
                                      Content="Enable autosave (restart required)" />
                            <TextBlock Grid.Row="2" Text="Offer restore on launch" Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding Sessions.OfferRestoreOnLaunch}"
                                      Content="Prompt to restore the latest board (restart required)" />
                            <TextBlock Grid.Row="3" Text="Local performance telemetry" Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding Diagnostics.EnableLocalPerformanceTelemetry}"
                                      Content="Record local timing counters only (restart required)" />
                        </Grid>
                        <TextBlock Margin="0,18,0,0"
                                   Text="Theme changes can be applied immediately. Other settings take effect after restart."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagram">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Diagram" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Default intent mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="IntentModeCombo" Grid.Column="1" MinHeight="32" Margin="0,4"
                                      SelectedItem="{Binding DiagramIntent.SelectionMode}"
                                      AutomationProperties.Name="Default diagram intent mode" />
                            <TextBlock Grid.Row="1" Text="Pinned intent" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PinnedIntentCombo" Grid.Row="1" Grid.Column="1" MinHeight="32" Margin="0,4"
                                      SelectedItem="{Binding DiagramIntent.PinnedIntent}"
                                      AutomationProperties.Name="Default pinned diagram intent" />
                            <TextBlock Grid.Row="2" Text="Realtime update interval (seconds)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Realtime.MinIntervalSeconds}" />
                            <TextBlock Grid.Row="3" Text="Segments before update" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding Realtime.MinNewSegments}" />
                            <TextBlock Grid.Row="4" Text="Deep refinement pause (seconds)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding Realtime.DeepPauseSeconds}" />
                            <TextBlock Grid.Row="5" Text="Azure architecture icon folder" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding Realtime.AzureIconsPath}"
                                     AutomationProperties.Name="Azure icon path" />
                            <TextBlock Grid.Row="6" Text="Image generation" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="6" Grid.Column="1">
                                <CheckBox IsChecked="{Binding ImageGeneration.Enabled}"
                                          Content="Enable image generation (restart required)" />
                                <TextBox Text="{Binding ImageGeneration.DeploymentName}"
                                         ToolTip="Optional image model deployment preference"
                                         AutomationProperties.Name="Image generation deployment" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Audio" Style="{StaticResource SectionHeading}" />
                        <CheckBox IsChecked="{Binding Audio.CaptureMicrophone}"
                                  Content="Capture microphone (restart required)"
                                  AutomationProperties.Name="Capture microphone" />
                        <CheckBox IsChecked="{Binding Audio.CaptureLoopback}"
                                  Content="Capture system / loopback audio (restart required)"
                                  AutomationProperties.Name="Capture loopback audio" />
                        <TextBlock Margin="0,18,0,0"
                                   Text="Choose the active microphone from the audio-input menu on the main command bar."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Transcription">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Transcription" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Backend" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="BackendCombo" Grid.Column="1" MinHeight="32" Margin="0,4"
                                      SelectedItem="{Binding CloudTranscription.Backend}"
                                      AutomationProperties.Name="Transcription backend" />
                            <TextBlock Grid.Row="1" Text="Language" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CloudTranscription.Language}" />
                            <TextBlock Grid.Row="2" Text="Cloud deployment preference" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding CloudTranscription.DeploymentName}" />
                            <TextBlock Grid.Row="3" Text="Utterance window (seconds)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding CloudTranscription.WindowSeconds}" />
                            <TextBlock Grid.Row="4" Text="Silence flush (milliseconds)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding CloudTranscription.SilenceFlushMs}" />
                            <TextBlock Grid.Row="5" Text="Maximum backlog (seconds)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding CloudTranscription.MaxBufferedSeconds}" />
                            <TextBlock Grid.Row="6" Text="Local Whisper model" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     Text="{Binding Whisper.ModelSize}" />
                            <TextBlock Grid.Row="7" Text="Local Whisper language" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Text="{Binding Whisper.Language}" />
                            <TextBlock Grid.Row="8" Text="Speech language / end silence" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="180" Text="{Binding AzureSpeech.Language}" />
                                <TextBox Width="120" Margin="8,4,0,4" Text="{Binding AzureSpeech.EndSilenceMs}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,16,0,0" Text="Transcription changes require restart."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AzureTab" Header="Azure">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Azure" Style="{StaticResource SectionHeading}" />
                        <ui:Button Content="Choose resources and models..."
                                   Click="OnChooseModels" HorizontalAlignment="Left"
                                   Appearance="Primary" Margin="0,0,0,10"
                                   AutomationProperties.Name="Choose Azure resources and models" />
                        <TextBlock Text="Browse deployed models under your signed-in account, or set up Azure OpenAI / Foundry if none are available. Model and tenant changes take effect with Save &amp; Restart."
                                   TextWrapping="Wrap" Margin="0,0,0,18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Model account profile" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="ModelAccountCombo"
                                          MinHeight="32" Margin="0,4"
                                          SelectionChanged="OnModelAccountSelectionChanged"
                                          AutomationProperties.Name="Model account profile" />
                                <TextBox x:Name="ModelAccountNameBox"
                                             ToolTip="A local name such as New tenant production" />
                                <WrapPanel>
                                    <ui:Button Margin="0,4,8,4" Content="New profile"
                                               Click="OnNewModelAccountProfile" />
                                    <ui:Button Margin="8,4,0,4" Content="Save profile"
                                               Click="OnSaveModelAccountProfile" />
                                    <ui:Button Margin="8,4,0,4" Content="Delete profile"
                                               Click="OnDeleteModelAccountProfile" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Tenant ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AzureOpenAI.TenantId}"
                                     AutomationProperties.Name="Azure tenant ID" />
                            <TextBlock Grid.Row="2" Text="Subscription ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AzureOpenAI.SubscriptionId}"
                                     AutomationProperties.Name="Azure subscription ID" />
                            <TextBlock Grid.Row="3" Text="Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AzureOpenAI.Endpoint}" />
                            <TextBlock Grid.Row="4" Text="Primary model deployment" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AzureOpenAI.DeploymentName}" />
                            <TextBlock Grid.Row="5" Text="Fallback model deployment" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AzureOpenAI.FallbackDeploymentName}" />
                            <TextBlock Grid.Row="6" Text="Preferred region" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AzureOpenAI.PreferredRegion}" />
                            <TextBlock Grid.Row="7" Text="Authentication / discovery" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding AzureOpenAI.UseManagedIdentity}"
                                          Content="Managed identity / Azure sign-in" />
                                <CheckBox Margin="18,7,0,7" IsChecked="{Binding AzureOpenAI.AutoDiscover}"
                                          Content="Auto-discover deployments" />
                            </StackPanel>
                            <TextBlock Grid.Row="8" Text="Optional Azure OpenAI API key" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="8" Grid.Column="1">
                                <PasswordBox x:Name="AzureOpenAIApiKeyBox"
                                             MinHeight="32" Margin="0,4"
                                             AutomationProperties.Name="Azure OpenAI API key" />
                                <CheckBox x:Name="ClearAzureOpenAIApiKeyBox"
                                          Content="Remove the saved Azure OpenAI API key" />
                            </StackPanel>
                            <TextBlock Grid.Row="9" Text="Speech region" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding AzureSpeech.Region}" />
                            <TextBlock Grid.Row="10" Text="Speech resource ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding AzureSpeech.ResourceId}" />
                            <TextBlock Grid.Row="11" Text="Optional Speech API key" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="11" Grid.Column="1">
                                <PasswordBox x:Name="AzureSpeechApiKeyBox"
                                             MinHeight="32" Margin="0,4"
                                             AutomationProperties.Name="Azure Speech API key" />
                                <CheckBox x:Name="ClearAzureSpeechApiKeyBox"
                                          Content="Remove the saved Azure Speech API key" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,14,0,0"
                                   Text="Keys are password-masked. Leave a key blank to preserve it, type a replacement, or explicitly select Remove saved key. Azure changes require restart."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Privacy &amp; Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Privacy &amp; Data" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="AudioBoarder keeps saved board state, UI preferences, cached sign-in metadata, update files, logs, and browser cache under your local application data folder. Settings are stored separately in appsettings.Local.json."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                            <ui:Button Content="Open data folder"
                                       Click="OnOpenDataFolder"
                                       AutomationProperties.Name="Open AudioBoarder data folder" />
                            <ui:Button Margin="10,0,0,0"
                                       Content="Delete local data…"
                                       Appearance="Danger"
                                       Click="OnDeleteLocalData"
                                       AutomationProperties.Name="Delete local AudioBoarder data" />
                        </StackPanel>
                        <TextBlock Margin="0,16,0,0"
                                   Text="Deletion always asks for confirmation and does not run external cleanup scripts."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="20,14"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Content="Cancel"
                               MinWidth="88"
                               Click="OnCancel"
                               AutomationProperties.Name="Cancel settings" />
                    <ui:Button Content="Save"
                               MinWidth="88"
                               Margin="8,0,0,0"
                               Click="OnSave"
                               AutomationProperties.Name="Save settings" />
                    <ui:Button Content="Save &amp; Restart"
                               Appearance="Primary"
                               MinWidth="130"
                               Margin="8,0,0,0"
                               Click="OnSaveAndRestart"
                               AutomationProperties.Name="Save settings and restart" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
