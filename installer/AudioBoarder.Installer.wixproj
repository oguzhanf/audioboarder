<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <MsiVersion Condition="'$(MsiVersion)' == ''">0.0.0</MsiVersion>
    <MsiOutputName Condition="'$(MsiOutputName)' == ''">AudioBoarder-v$(Version)-win-x64</MsiOutputName>
    <OutputName>$(MsiOutputName)</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>MsiVersion=$(MsiVersion);ArtifactVersion=$(Version);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
