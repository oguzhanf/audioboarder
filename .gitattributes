# Normalise line endings on commit; check out native on each platform.
* text=auto

# Windows-specific scripts stay CRLF so PowerShell/cmd never see stray LF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source
*.cs    text diff=csharp
*.csproj text
*.sln   text eol=crlf
*.props text
*.json  text
*.md    text
*.xaml  text
*.js    text
*.jsx   text
*.html  text
*.css   text

# Binary assets — never diff or convert these.
*.png   binary
*.jpg   binary
*.ico   binary
*.onnx  binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# The vendored Excalidraw bundle is generated output: keep it out of diffs and
# out of EOL conversion (rewriting LF to CRLF would churn every byte of it).
src/AudioBoarder.App/Assets/web/** linguist-vendored
src/AudioBoarder.App/Assets/web/** -text

# Official architecture SVGs remain byte-identical to Microsoft's permitted-use originals.
src/AudioBoarder.Core/Assets/AzureIcons/*.svg -text linguist-vendored
